# Local development only. Never use these values for a real runtime.
CRYPTO_DEV_MODE=true
CRYPTO_ADMIN_USERNAME=admin
CRYPTO_ADMIN_PASSWORD=local-dev-password
CRYPTO_SESSION_SECRET=local-dev-session-secret-change-me
CRYPTO_EXECUTION_MODE=DISABLED
CRYPTO_DATABASE_URL=sqlite:///data/history/.runtime/control-plane.sqlite3
CRYPTO_REDIS_URL=
CRYPTO_PERSISTENCE_REQUIRED=false
CRYPTO_TASK_QUEUE_MODE=local
CRYPTO_BIND_ADDRESS=127.0.0.1
CRYPTO_BACKEND_PORT=8290
CRYPTO_FRONTEND_PORT=4191
CRYPTO_SCHEDULER_INTERVAL_SECONDS=900
CRYPTO_SCHEDULER_BACKOFF_INITIAL_SECONDS=300
CRYPTO_SCHEDULER_BACKOFF_MAX_SECONDS=21600
CRYPTO_TASK_MAX_ATTEMPTS=3
CRYPTO_TASK_LEASE_SECONDS=900
CRYPTO_TASK_MAX_RUNTIME_SECONDS=3600
CRYPTO_TASK_MAX_PAYLOAD_BYTES=262144
CRYPTO_TASK_MAX_RESULT_BYTES=2097152
CRYPTO_TASK_MAX_ITEMS=100
CRYPTO_TASK_RECOVERY_GRACE_SECONDS=60
CRYPTO_TASK_LOG_RETENTION_DAYS=365
CRYPTO_TASK_LOG_BACKUP_PATH=data/history/.runtime/task-log-backups/latest.tar
CRYPTO_TASK_LOG_RESTORE_PATH=data/history/.runtime/task-log-restore-rehearsal
CRYPTO_HISTORY_DATA_PATH=data/history
CRYPTO_HISTORY_TIMEOUT_SECONDS=10
CRYPTO_HISTORY_PAGE_PAUSE_SECONDS=0.05
CRYPTO_HISTORY_MAX_PAGES=2000
CRYPTO_HISTORY_TRUST_ENV=false
CRYPTO_PUBLIC_TRUST_ENV=false
CRYPTO_BINANCE_HISTORY_BASE_URL=https://data-api.binance.vision
CRYPTO_OKX_HISTORY_BASE_URL=https://www.okx.com
CRYPTO_BYBIT_HISTORY_BASE_URL=https://api.bybit-tr.com
CRYPTO_BINANCE_PUBLIC_REST_BASE_URL=https://data-api.binance.vision
CRYPTO_OKX_PUBLIC_REST_BASE_URL=https://www.okx.com
CRYPTO_BYBIT_PUBLIC_REST_BASE_URL=https://api.bybit-tr.com
CRYPTO_BINANCE_PUBLIC_WS_BASE_URL=wss://data-stream.binance.vision
CRYPTO_OKX_PUBLIC_WS_BASE_URL=wss://ws.okx.com:8443/ws/v5/public
CRYPTO_BYBIT_PUBLIC_WS_BASE_URL=wss://stream.bybit.kz/v5/public/spot
CRYPTO_BINANCE_PUBLIC_HTTP_PROXY=
CRYPTO_OKX_PUBLIC_HTTP_PROXY=
CRYPTO_BYBIT_PUBLIC_HTTP_PROXY=
CRYPTO_BINANCE_PUBLIC_WS_PROXY=
CRYPTO_OKX_PUBLIC_WS_PROXY=
CRYPTO_BYBIT_PUBLIC_WS_PROXY=
CRYPTO_PUBLIC_NETWORK_SETTINGS_PATH=data/history/.runtime/public-network-settings.json
CRYPTO_PUBLIC_NETWORK_SETTINGS_POLL_SECONDS=2
CRYPTO_MARKET_RETRY_INITIAL_SECONDS=1
CRYPTO_MARKET_RETRY_MAX_SECONDS=30
CRYPTO_MARKET_SHUTDOWN_GRACE_PERIOD=30s
# Public market collection is opt-in. Keep the allowlist empty unless a
# development or controlled runtime explicitly needs live read-only books.
CRYPTO_MARKET_WORKER_ENABLED=false
CRYPTO_MARKET_INSTRUMENTS=
CRYPTO_MARKET_MAX_AGE_SECONDS=2
CRYPTO_MARKET_DEPTH_LIMIT=100
CRYPTO_MARKET_BYBIT_DEPTH_LIMIT=50
CRYPTO_MARKET_WS_SPEED_MS=100
CRYPTO_MARKET_REST_TIMEOUT_SECONDS=5
CRYPTO_BYBIT_MARKET_WS_URL=wss://stream.bybit.kz/v5/public/spot
