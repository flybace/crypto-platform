# crypto-platform 本地配置示例
# 复制为 .env 后按需修改（install.sh 会自动生成，手动安装时参考此文件）：
#   cp .env.example .env

# 管理员登录
CRYPTO_ADMIN_USERNAME=flybace
CRYPTO_ADMIN_PASSWORD=请改成强密码

# 会话密钥（随机 32 位以上字符串）
CRYPTO_SESSION_SECRET=请改成随机字符串

# 数据库密码
CRYPTO_POSTGRES_PASSWORD=请改成强密码

# 服务监听地址：本机用 127.0.0.1，局域网共享用 0.0.0.0
CRYPTO_BIND_ADDRESS=127.0.0.1
CRYPTO_BACKEND_PORT=8290
CRYPTO_FRONTEND_PORT=4191

# 执行模式：DISABLED = 真实下单强制关闭（默认，勿改）
CRYPTO_EXECUTION_MODE=DISABLED

# 数据库名/用户（一般不用改）
CRYPTO_POSTGRES_DB=crypto_platform
CRYPTO_POSTGRES_USER=crypto_app
