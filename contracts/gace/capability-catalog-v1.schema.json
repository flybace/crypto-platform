{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-platform.local/contracts/gace/capability-catalog-v1.schema.json",
  "title": "GACE read-only capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "app_version",
    "runtime",
    "execution_mode",
    "read_only",
    "capabilities",
    "write_capabilities",
    "blocked_actions",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "gace-capability-catalog-v1"},
    "app_id": {"type": "string", "minLength": 1},
    "app_version": {"type": "string", "minLength": 1},
    "runtime": {"const": "standalone"},
    "execution_mode": {"type": "string", "minLength": 1},
    "read_only": {"const": true},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "scope", "description", "requires_auth", "risk_level", "enabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "method": {"const": "GET"},
          "path": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "requires_auth": {"type": "boolean"},
          "risk_level": {"const": "READ_ONLY"},
          "enabled": {"const": true}
        }
      }
    },
    "write_capabilities": {"type": "array", "maxItems": 0},
    "blocked_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risk_level", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "risk_level": {"enum": ["CONTROLLED_WRITE", "HIGH_RISK"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
