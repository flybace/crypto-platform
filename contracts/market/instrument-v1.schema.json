{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-platform.local/contracts/market/instrument-v1.schema.json",
  "title": "Market instrument v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "venue_id",
    "market_type",
    "base_asset",
    "quote_asset",
    "native_symbol",
    "canonical_symbol",
    "price_tick",
    "quantity_step",
    "min_quantity",
    "min_notional"
  ],
  "properties": {
    "venue_id": {"type": "string", "minLength": 1},
    "market_type": {"enum": ["spot", "margin", "perpetual", "futures", "dex"]},
    "base_asset": {"type": "string", "minLength": 1},
    "quote_asset": {"type": "string", "minLength": 1},
    "native_symbol": {"type": "string", "minLength": 1},
    "canonical_symbol": {"type": "string", "pattern": "^[A-Z0-9]+/[A-Z0-9]+$"},
    "price_tick": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "quantity_step": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "min_quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "min_notional": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}
  }
}
